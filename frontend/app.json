{
  "expo": {
    "name": "Tenachin AI",
    "slug": "tenachin-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tenachin-ai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B4D3B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tenachinai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B4D3B"
      },
      "package": "com.tenachinai.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b6b8efd-fcdb-4c35-8bcb-d166b0bb5b5a"
      }
    },
    "owner": "aklilwassies-team"
  }
}
